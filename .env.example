# Galaxy (Jarvis) Environment Configuration
# Copy to .env and fill in your API keys (or leave blank for auto-detection)

# Server Settings (0.0.0.0 allows phones/laptops on same Wi-Fi)
HOST=0.0.0.0
PORT=8000

# Local Models (Ollama — installed automatically based on your specs)
OLLAMA_HOST=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen2.5:3b
MISTRAL_LOCAL_MODEL=mistral
PREFERRED_MODEL=mistral
PREFERRED_PROVIDER=auto

# Free Cloud API Keys (Optional — paste your own or leave blank)
# Get free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get free Groq key: https://console.groq.com/keys  
GROQ_API_KEY=
# Get Mistral key: https://console.mistral.ai
MISTRAL_API_KEY=

# Security & Sandboxing
APPROVAL_TIMEOUT_MINUTES=5
MAX_COMMAND_TIMEOUT=120
